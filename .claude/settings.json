{
  "extraKnownMarketplaces": {
    "cedricziel": {
      "source": {
        "source": "github",
        "repo": "cedricziel/claude-plugins",
        "sha": "14e0526ac595725e51e9840aabc3581c838806dd"
      }
    }
  },
  "enabledPlugins": {
    "oss@cedricziel": true
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/setup-worktree.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "statusMessage": "Formatting..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/install-claude-plugins.sh"
          }
        ]
      }
    ]
  }
}

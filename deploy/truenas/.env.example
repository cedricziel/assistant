# Copy to .env next to docker-compose.yml and edit.
#   cp .env.example .env

# ── Storage ───────────────────────────────────────────────────────────────────
# Host path for the runtime tree (~/.assistant inside the container).
# Create it as a dataset, then: chown -R 100:101 <path>
ASSISTANT_DATA=/mnt/tank/apps/assistant

# ── Image ─────────────────────────────────────────────────────────────────────
# Pin a release tag instead of `latest` so a restart can't silently upgrade you.
ASSISTANT_TAG=latest

# ── Web UI ────────────────────────────────────────────────────────────────────
# Host port for the web UI.
ASSISTANT_PORT=8080

# Binding to a non-loopback address auto-sets the `Secure` cookie attribute,
# which browsers refuse over plain HTTP — login then silently fails.
# Keep --no-secure-cookie for LAN/VPN access over http://.
# Clear this line when a reverse proxy terminates TLS in front of the container.
ASSISTANT_WEBUI_ARGS=--no-secure-cookie

# External URL when behind a reverse proxy (OAuth issuer + A2A agent card).
# ASSISTANT_PUBLIC_URL=https://assistant.example.org

# Required for the first login on a fresh install: with no orgs/<slug>/org.db
# present the server has no users yet and falls back to legacy single-token
# auth. Multi-user mode takes over automatically once org.db exists.
ASSISTANT_WEB_TOKEN=change-me

# ── Orchestrator ──────────────────────────────────────────────────────────────
# Messenger adapters to load, e.g. slack,mattermost,matrix,nextcloud,signal.
# Empty = scheduler + bus + web worker only.
ASSISTANT_INTERFACES=

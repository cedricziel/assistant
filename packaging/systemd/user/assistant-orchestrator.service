[Unit]
Description=AI Assistant — orchestrator (scheduler + bus + interface adapters)
Documentation=https://github.com/cedricziel/assistant
# Wait for a network route to be available before starting.
After=network-online.target

[Service]
Type=simple

# Configure which platform adapters to load via:
#
#   echo 'ASSISTANT_INTERFACES=slack,matrix' > ~/.config/assistant/orchestrator.env
#   systemctl --user restart assistant-orchestrator
#
# Leave the env file empty (or omit it) to run only the scheduler + bus
# without any platform adapters — useful for headless deploys.
EnvironmentFile=-%h/.config/assistant/orchestrator.env

# `--interfaces` reads from $ASSISTANT_INTERFACES via the CLI's clap binding,
# so a single ExecStart line covers all configurations.
ExecStart=/usr/local/bin/assistant orchestrator run --no-repl
Restart=always
RestartSec=5

# All log output goes to the user journal.
# View with: journalctl --user -u assistant-orchestrator -f
StandardOutput=journal
StandardError=journal

# Allow up to 10 seconds for a clean shutdown before systemd kills the process.
TimeoutStopSec=10

[Install]
# Start automatically when the user's session target is reached.
WantedBy=default.target

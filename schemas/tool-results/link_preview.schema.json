{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assistant.invalid/schemas/tool-results/link_preview.schema.json",
  "title": "link_preview",
  "description": "Preview of a fetched web page.",
  "type": "object",
  "additionalProperties": true,
  "required": ["kind", "url", "final_url", "status"],
  "properties": {
    "kind": { "const": "link_preview" },
    "url": { "type": "string" },
    "final_url": { "type": "string" },
    "status": { "type": "integer" },
    "title": { "type": "string" },
    "content_type": { "type": "string" },
    "excerpt": { "type": "string", "maxLength": 280 }
  }
}
